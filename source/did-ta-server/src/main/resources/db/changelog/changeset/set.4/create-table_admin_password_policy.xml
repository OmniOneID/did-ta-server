<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="create-table_admin_password_policy" author="system">
        <createTable tableName="admin_password_policy">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="min_length" type="smallint" defaultValue="8">
                <constraints nullable="false"/>
            </column>
            <column name="require_uppercase" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="require_number" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="require_special" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="password_expiry_days" type="smallint" defaultValue="365">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <insert tableName="admin_password_policy">
            <column name="min_length" value="8"/>
            <column name="require_uppercase" valueBoolean="false"/>
            <column name="require_number" valueBoolean="false"/>
            <column name="require_special" valueBoolean="false"/>
            <column name="password_expiry_days" value="365"/>
        </insert>
    </changeSet>
</databaseChangeLog>
