<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <!-- entity_id references entity.id logically only (no FK), so existing entity deletion is never blocked. -->
    <changeSet id="create-table-list_mdoc_issuer" author="jinhwankim">
        <createTable tableName="list_mdoc_issuer">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
        </createTable>
        <addUniqueConstraint tableName="list_mdoc_issuer"
                             columnNames="entity_id"
                             constraintName="uk_list_mdoc_issuer_entity_id"/>
        <createIndex tableName="list_mdoc_issuer" indexName="idx_mdoc_issuer_status">
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
